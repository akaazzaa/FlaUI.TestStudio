<Window x:Class="FlaUI.TestStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FlaUI.TestStudio.App.Converters"
        Title="FlaUI Test Studio" Width="1200" Height="760"
        Background="{DynamicResource Brush.Window}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StepTypeToIconConverter x:Key="StepTypeToIcon"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ===================== Toolbar ===================== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ApplicationComboBox" DisplayMemberPath="DisplayName" Width="220" Foreground="Black"  />
                <Button Content="Aktualisieren" Click="RefreshApplications_Click" Margin="6,0,0,0"/>
                <Button Content="Verbinden" Click="Connect_Click" Margin="6,0,0,0"/>

                <Rectangle Style="{StaticResource Separator.Vertical}"/>

                <Button Content="Neu" Click="NewTest_Click"/>
                <Button Content="Öffnen" Click="Open_Click" Margin="6,0,0,0"/>
                <Button Content="Speichern" Click="Save_Click" Margin="6,0,0,0"/>

                <Rectangle Style="{StaticResource Separator.Vertical}"/>

                <Button x:Name="RecordButton" Content="● Aufnehmen" Click="Record_Click" Style="{StaticResource Button.Danger}"/>
                <Button Content="Stopp" Click="StopRecord_Click" Margin="6,0,0,0"/>

                <Rectangle Style="{StaticResource Separator.Vertical}"/>

                <Button Content="▶  Test ausführen" Click="Run_Click" Style="{StaticResource Button.Primary}" Padding="16,6"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== Aktionen ===================== -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <TextBlock Text="Schritt hinzufügen" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                    <Button Content="+ Click" Click="AddClick_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
                    <Button Content="+ Text setzen" Click="AddText_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
                    <Button Content="+ Warten" Click="AddWait_Click" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
                    <Button Content="+ Sichtbarkeit prüfen" Click="AddAssert_Click" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ===================== Testschritte ===================== -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TestNameBox" Text="Neuer Test" FontWeight="SemiBold" FontSize="14"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="↑" Click="MoveUp_Click" Style="{StaticResource Button.Icon}"/>
                            <Button Content="↓" Click="MoveDown_Click" Style="{StaticResource Button.Icon}" Margin="4,0,0,0"/>
                            <Button Content="Löschen" Click="Delete_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="StepsList" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Type, Converter={StaticResource StepTypeToIcon}}"
                                               FontSize="15" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}"
                                               FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===================== Inspector / Recorder ===================== -->
            <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Inspector" Style="{StaticResource SectionHeader}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Brush.TextMuted}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Bereit." Margin="8,0,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="AutomationId" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AutomationIdBox" IsReadOnly="True" Style="{StaticResource TextBox.Mono}"/>

                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" IsReadOnly="True" Style="{StaticResource TextBox.Mono}"/>

                    <TextBlock Text="ControlType" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ControlTypeBox" IsReadOnly="True" Style="{StaticResource TextBox.Mono}"/>

                    <Button Content="Element auswählen (Maus)" Click="PickElement_Click" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== Execution Log ===================== -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Execution Log" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBox.Mono}"
                             Background="{StaticResource Brush.Window}"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
