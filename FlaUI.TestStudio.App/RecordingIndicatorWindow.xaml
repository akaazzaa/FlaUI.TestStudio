<Window x:Class="FlaUI.TestStudio.App.Overlay.RecordingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#DD1A1B1E" BorderBrush="#E5484D" BorderThickness="1.5" CornerRadius="8" Padding="14,10">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#E5484D" VerticalAlignment="Center"/>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Aufnahme läuft" FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="InfoText" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           Foreground="#9BA1AC" Margin="0,3,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="F8 Click, F9 Text, F10 Warten, F11 Prüfen, F12 Stopp"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="10"
                           Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
